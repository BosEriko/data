{
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "Open Browser",
          "commands": ["wslview 'http://localhost:3000/' && exit"]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Rails Server",
          "commands": [
            "sudo service redis-server start",
            "sudo service postgresql start",
            "bundle exec bin/dev"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Console",
          "commands": [
            "rails console"
          ]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Terminal",
          "commands": ["clear"]
        }
      ]
    }
  ]
}